# Copy this file to .env and fill in your keys.
# The .env file is gitignored and NEVER committed.

# Justwoker AI API (claude-opus-4-8 / claude-opus-5) — used by the grammar data pipeline.
# Two keys are rotated in parallel for throughput.
JUSTWOKER_KEYS=sk-your-key-1,sk-your-key-2
# OR set individually:
# JUSTWOKER_KEY_1=sk-your-key-1
# JUSTWOKER_KEY_2=sk-your-key-2

# Optional overrides:
# JUSTWOKER_API_URL=https://api.justwoker.icu/v1/chat/completions
# JUSTWOKER_MODEL=claude-opus-4-8

# Required by scripts/verify_roots_ai.py and scripts/verify_roots_deep.py
# (etymology verification pipeline). Comma-separated list of API keys, rotated
# for throughput. Defaults to the kktoken.cc proxy endpoint and claude-opus-4-8.
OPENAI_API_KEYS=sk-your-key-1-here,sk-your-key-2-here,sk-your-key-3-here
# (Optional) Override the AI endpoint for the verify_roots_* scripts:
# API_URL=https://kktoken.cc/v1/chat/completions
# (Optional) Override the model for the verify_roots_* scripts:
# MODEL=claude-opus-4-8
