# Copy this file to .env and fill in your keys.
# The .env file is gitignored and NEVER committed.

# Justwoker AI API (claude-opus-4-8 / claude-opus-5) — used by the grammar data pipeline.
# Two keys are rotated in parallel for throughput.
JUSTWOKER_KEYS=sk-your-key-1,sk-your-key-2
# OR set individually:
# JUSTWOKER_KEY_1=sk-your-key-1
# JUSTWOKER_KEY_2=sk-your-key-2

# Optional overrides:
# JUSTWOKER_API_URL=https://api.justwoker.icu/v1/chat/completions
# JUSTWOKER_MODEL=claude-opus-4-8
