---
// src/pages/word/[word].astro
import Layout from '../../layouts/Layout.astro';
import WordDetailView from '../../components/WordDetailView.svelte';
import { readFileSync } from 'node:fs';

export function getStaticPaths() {
  const words = JSON.parse(readFileSync('public/data/words.json', 'utf-8'));
  return words.map((w: any) => ({ params: { word: w.wordLower }, props: { word: w } }));
}

const { word } = Astro.props;
---
<Layout title={`${word.word} | SSC PYQs`}>
  <section>
    <!-- SSR'd header so users see content immediately (no white flash) -->
    <div class="text-xs text-zinc-500 flex items-center gap-1.5 mb-4">
      <a href="/" class="hover:text-orange-600">Home</a><span>/</span>
      <a href="/stems" class="hover:text-orange-600">Vocab</a><span>/</span>
      <span class="text-zinc-700 dark:text-zinc-300">{word.word}</span>
    </div>
    <WordDetailView client:idle word={word} />
  </section>
</Layout>
