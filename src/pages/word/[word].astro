---
// src/pages/word/[word].astro
import Layout from '../../layouts/Layout.astro';
import WordDetail from '../../components/WordDetail.svelte';

export async function getStaticPaths() {
  // Pre-render ALL word pages at build time
  const fs = await import('node:fs');
  const path = await import('node:path');
  const filePath = path.resolve('public/data/words.json');
  let wordsData: Array<{wordLower: string; word: string}> = [];
  try {
    const content = fs.readFileSync(filePath, 'utf-8');
    wordsData = JSON.parse(content);
  } catch (err) {
    console.error('Failed to read words.json for prerender:', err);
  }
  return wordsData.map((w) => ({
    params: { word: w.wordLower },
    props: { wordLower: w.wordLower, wordDisplay: w.word }
  }));
}

const { wordLower, wordDisplay } = Astro.props;
---
<Layout title={`${wordDisplay} | SSC Vocab Master`} activeNav="">
  <WordDetail client:load wordLower={wordLower} wordDisplay={wordDisplay} />
</Layout>
