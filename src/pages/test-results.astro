---
// src/pages/test-results.astro
// View test results — reads the attempt ID from ?id= query param.
import Layout from '../layouts/Layout.astro';
import TestResults from '../components/TestResults.svelte';

const id = parseInt(Astro.url.searchParams.get('id') || '0', 10);
---
<Layout title="Test Results | SSC PYQs">
  <section>
    {id > 0 ? (
      <TestResults client:load attemptId={id} />
    ) : (
      <div class="bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800 rounded-lg p-6 text-center">
        <p class="text-sm text-rose-700 dark:text-rose-300 font-medium">No test ID specified.</p>
        <a href="/tests" class="inline-block mt-3 text-xs h-8 px-4 leading-8 rounded-md bg-rose-600 text-white font-medium hover:bg-rose-700">Back to Tests</a>
      </div>
    )}
  </section>
</Layout>
