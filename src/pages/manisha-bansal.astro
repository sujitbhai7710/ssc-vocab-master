---
// src/pages/manisha-bansal.astro
import Layout from '../layouts/Layout.astro';
import ManishaBansalView from '../components/ManishaBansalView.svelte';
---
<Layout title="Manisha Bansal 120 Grammar Rules | SSC PYQs" activeNav="manisha-bansal">
  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="M8 11h8"/><path d="M8 7h6"/></svg>
        Manisha Bansal — 120 Grammar Rules
      </h2>
      <p class="text-sm text-zinc-500 mt-1 leading-relaxed">
        120 grammar rules with explanations, usage notes, examples, and tricks. Click any rule to expand. Bengali meanings included where applicable. Mark rules as problematic for revision.
      </p>
    </div>
    <ManishaBansalView client:load />
  </section>
</Layout>
