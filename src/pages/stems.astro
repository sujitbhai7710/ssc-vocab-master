---
// src/pages/stems.astro
import Layout from '../layouts/Layout.astro';
import WordAccordion from '../components/WordAccordion.svelte';
import ProgressTracker from '../components/ProgressTracker.svelte';
import { loadWords } from '../lib/vocab-data';

// Pre-render the words list at build time so the page hydrates fast
let initialWords = [];
let stemCount = 0;
try {
  const fs = await import('node:fs');
  initialWords = JSON.parse(fs.readFileSync('public/data/words.json', 'utf-8'));
  stemCount = initialWords.filter((w: any) => w.asStem > 0).length;
} catch (e) {}
---
<Layout title="Module 1 — Main Question Stems | SSC Vocab Master" activeNav="stems">
  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
        Module 1 — Main Question Stems
      </h2>
      <p class="text-sm text-zinc-500 mt-1 leading-relaxed">
        Words that appeared as the main question word in synonym/antonym questions across SSC exams. Click any card to expand — see definition, Bengali meaning, root, mnemonic, and practice MCQs inline.
      </p>
    </div>
    <ProgressTracker client:idle pageType="stems" total={stemCount} />
    <WordAccordion client:load view="stems" words={initialWords} />
  </section>
</Layout>
