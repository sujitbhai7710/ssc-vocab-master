---
// src/pages/roots.astro
import Layout from '../layouts/Layout.astro';
import RootsView from '../components/RootsView.svelte';
---
<Layout title="Module 7 — Root Words | SSC Vocab Master" activeNav="roots">
  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-600"><path d="M12 5v14"/><path d="M5 12h14"/><circle cx="12" cy="12" r="9"/></svg>
        Module 7 — Root Words
      </h2>
      <p class="text-sm text-zinc-500 mt-1 leading-relaxed">
        1,603 Latin/Greek root word families. Each family shows the root, its meaning (English + Bengali), and all the words derived from it with their own meanings, mnemonics, and SSC appearance counts.
      </p>
    </div>
    <RootsView client:load />
  </section>
</Layout>
