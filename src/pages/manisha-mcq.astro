---
// src/pages/manisha-mcq.astro
import Layout from '../layouts/Layout.astro';
import ManishaMCQView from '../components/ManishaMCQView.svelte';
---
<Layout title="Manisha Bansal MCQ Practice | SSC PYQs" activeNav="manisha-mcq">
  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-600"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Manisha Bansal — 360 MCQ Practice
      </h2>
      <p class="text-sm text-zinc-500 mt-1 leading-relaxed">
        360 practice questions with explanations. Click an option to reveal the answer — green if correct, red if wrong. Track your progress and mark questions as problematic.
      </p>
    </div>
    <ManishaMCQView client:load />
  </section>
</Layout>
