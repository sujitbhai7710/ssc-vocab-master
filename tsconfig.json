{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*", "src/env.d.ts"],
  "exclude": ["dist", "node_modules"]
}
