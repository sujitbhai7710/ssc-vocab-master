{
  "name": "sscpyqs",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "SSC PYQs — 5 years of SSC synonyms, antonyms, grammar rules, narration & voice. Built with Astro + Svelte + Tailwind. Static site deployed to Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "deploy": "astro build && wrangler pages deploy ./dist --project-name=sscpyqs"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.0.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "wrangler": "^4.0.0"
  }
}
